NODE_ENV=development
PORT=3000
# Número de proxies delante de la app (Nginx = 1). Lo usa el rate limiting para la IP real.
TRUST_PROXY_HOPS=1

# Conexión DIRECTA (en Neon, el host sin "-pooler"): la RLS por institución (spec 113) fija el rol y la institución
# en la sesión de PostgreSQL, y PgBouncer en modo transacción la cambiaría de sesión. La API no arranca con "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/necon?schema=public"
# Conexiones del pool de cada proceso (API y worker); por defecto 20.
# DATABASE_POOL_MAX=20

# Caché de 60 s de la cuenta del JWT, la tableta del token y la configuración (spec 114). Con REDIS_URL vive en Redis
# (la comparten la API y el worker); vacío, en la memoria de cada proceso. En Docker la pone compose (redis://redis:6379).
REDIS_URL=
# Docker: IP de este equipo en la red local, donde se publica la API para las tabletas
# (EXPO_PUBLIC_API_URL=http://<LAN_IP>:3000 en la app). Vacía, solo localhost. Nunca abrir el puerto en el router.
LAN_IP=

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m

# Clave de la app móvil: va en el header X-App-Key (spec 103 FR-006). Es el "CORS" de la app nativa;
# va dentro del APK, así que solo filtra clientes ajenos (la seguridad real es el token + la firma).
APP_KEY=

# Orígenes de la web separados por coma (la cookie de refresh exige credenciales).
CORS_ORIGINS=http://localhost:5173
# URL de la web para armar el enlace de recuperación de contraseña.
WEB_URL=http://localhost:5173

# SMTP institucional. Sin SMTP_HOST el correo se escribe en el log (solo desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Necon <no-reply@example.org>"

# Administrador inicial que crea `pnpm db:seed` (solo si aún no hay un admin).
# Debe cambiar la contraseña en su primer inicio de sesión.
ADMIN_NAME="Administrador"
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Super administrador de la plataforma (spec 113): revisa las solicitudes de cuenta y crea instituciones.
SUPER_ADMIN_NAME="Plataforma Necon"
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Base para `pnpm test`: las pruebas e2e BORRAN tablas. Si falta, usan DATABASE_URL
# (solo si esa base es de pruebas, nunca la de producción).
DATABASE_URL_TEST=

# Bucket S3 de Neon para imágenes (pictogramas), grabaciones y consentimientos.
# Neon → Connect → Storage → "Parameters only". La base guarda solo el path; la API firma las URLs.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
S3_BUCKET=uploads

# Spec 104: cifrado AES-256-GCM de la foto del consentimiento (32 bytes en base64). Generar con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Si se pierde, los consentimientos guardados no se pueden leer: respaldarla aparte.
CONSENT_ENCRYPTION_KEY=

# Spec 010: servicio local de clonación de voz (~/Documents/tesis/Clonar-voz); lo llama el worker de la cola (pnpm start:worker).
VOICE_CLONE_URL=http://127.0.0.1:8080

# Grabaciones del navegador (webm/ogg) a m4a: ffmpeg y ffprobe del sistema (por defecto, los del PATH).
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe
